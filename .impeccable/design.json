  "narrative": {
    "northStar": "The Working Paper",
    "overview": "Dapi's screens are an auditor's working papers for web data. A schedule sheet lies on a pale green-grey desk; graphite ink sets everything; and two pencil colours mark what was checked. Green means a check held. Red means an exception. Every delivered value carries the tick that says what it was checked against, and every dataset is footed against the source's own total on a double rule.",
    "keyCharacteristics": [
      "Pale green-grey ground, sheets one step lighter, no shadows at rest.",
      "Graphite ink; colour appears only as pencil marks on data and states.",
      "One grotesk (Archivo) whose condensed width sets titles and the footing figure; IBM Plex Mono only for requests, responses and seals.",
      "Tick marks on values, a legend docked under the table, totals on a double rule.",
      "Light only: it is read at a desk, like the paper it comes from."
    ],
    "rules": [
      {
        "name": "The Two Pencils Rule",
        "body": "Colour is only ever a pencil mark on data or state: green for a check that held, red for an exception. No colour on chrome, navigation or buttons.",
        "section": "colors"
      },
      {
        "name": "The Quiet Tick Rule",
        "body": "Where most values pass, the routine tick recedes (green at 45%) and only exceptions are drawn at full strength.",
        "section": "colors"
      },
      {
        "name": "The Typed Schedule Rule",
        "body": "The condensed cut is for the h1 and the footing figure only; nothing else is condensed.",
        "section": "typography"
      },
      {
        "name": "The Mono Is Evidence Rule",
        "body": "Monospace appears only where Dapi shows what a server said or sent: requests, responses, seals. Never as a \"technical\" costume.",
        "section": "typography"
      },
      {
        "name": "The Paper Lies Flat Rule",
        "body": "A border or a tone step, never both a border and a shadow; nothing at rest casts a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put every value's tick directly after it, and dock the legend under the table.",
      "Do foot every dataset against the source's own count, on the double rule, and name every gap with its reason.",
      "Do keep colour on data and state only: pencil green (#2b7449) and pencil red (#b3302a).",
      "Do right-align numbers and dates in tabular figures.",
      "Do show missing values as a grey dash and real zeros as \"0\"."
    ],
    "donts": [
      "Don't add shadows, gradients, glass or glows to resting surfaces.",
      "Don't set anything but the h1 and the footing figure in the condensed cut.",
      "Don't use monospace for anything but requests, responses and seals.",
      "Don't put a coloured fill on a button, a tab or the navigation.",
      "Don't add a dark theme; Dapi is paper."
    ]
  }
}